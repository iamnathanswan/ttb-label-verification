# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
MAX_UPLOAD_BYTES=10485760
MAX_BATCH_FILES=300
EXTRACTION_CONCURRENCY=8

# Required only when ANTHROPIC_API_KEY is org-scoped rather than workspace-scoped.
ANTHROPIC_WORKSPACE_ID=

# Override the extraction model if needed (default: claude-sonnet-5)
ANTHROPIC_MODEL=
